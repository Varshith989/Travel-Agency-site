# ==========================================
# AEROVA TRAVELS - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Base URL for SEO & callbacks
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. WhatsApp Concierge Number (Country code + digits without +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# 3. PostgreSQL Database Connection (Prisma)
# Replace with your actual database credentials
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/aerova_travels?schema=public"

# 4. Optional: Transactional Email (Resend or SendGrid)
# RESEND_API_KEY="re_123456789"

# 5. Optional: Payment Gateway (Stripe or Razorpay for online deposits)
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxx"
# RAZORPAY_KEY_SECRET="your_secret_key"
